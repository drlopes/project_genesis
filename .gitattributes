# Normalise text to LF in the repository and in working copies, on every OS.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: never touch line endings, never diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.fbx  binary
*.glb  binary
*.blend binary
*.psd  binary
*.ttf  binary
*.otf  binary

# Concept art goes through Git LFS (art/README.md). Only under art/; later lines win.
art/**/*.png   filter=lfs diff=lfs merge=lfs -text
art/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
art/**/*.jpeg  filter=lfs diff=lfs merge=lfs -text
art/**/*.webp  filter=lfs diff=lfs merge=lfs -text
art/**/*.gif   filter=lfs diff=lfs merge=lfs -text
art/**/*.tif   filter=lfs diff=lfs merge=lfs -text
art/**/*.tiff  filter=lfs diff=lfs merge=lfs -text
art/**/*.exr   filter=lfs diff=lfs merge=lfs -text
art/**/*.hdr   filter=lfs diff=lfs merge=lfs -text
art/**/*.psd   filter=lfs diff=lfs merge=lfs -text
art/**/*.psb   filter=lfs diff=lfs merge=lfs -text
art/**/*.kra   filter=lfs diff=lfs merge=lfs -text
art/**/*.xcf   filter=lfs diff=lfs merge=lfs -text
art/**/*.clip  filter=lfs diff=lfs merge=lfs -text
